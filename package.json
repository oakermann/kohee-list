{
  "name": "kohee-list",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test-api.mjs && node scripts/test-site.mjs && node scripts/test-cafe-candidates.mjs",
    "format": "prettier --write \"*.{html,json,md,toml}\" \"docs/**/*.md\" \".github/workflows/*.yml\" \"server/**/*.js\" \"functions/**/*.js\" \"site/**/*.{html,js,css}\" \"scripts/**/*.mjs\" --end-of-line auto --ignore-unknown",
    "format:check": "prettier --check \"*.{html,json,md,toml}\" \"docs/**/*.md\" \".github/workflows/*.yml\" \"server/**/*.js\" \"functions/**/*.js\" \"site/**/*.{html,js,css}\" \"scripts/**/*.mjs\" --end-of-line auto --ignore-unknown",
    "check:repo-safety": "node scripts/check-repo-safety.mjs",
    "smoke:check": "node scripts/smoke-check.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
